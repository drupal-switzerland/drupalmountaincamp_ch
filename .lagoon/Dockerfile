# Stage 1: Drupal dependencies
FROM uselagoon/php-8.3-cli-drupal:latest AS drupal-builder
COPY drupal /app/drupal
WORKDIR /app/drupal
RUN composer install --no-dev --optimize-autoloader

# Stage 2: Frontend build
FROM uselagoon/node-24-builder:latest AS frontend-builder
# Install bun
RUN npm install -g bun@latest
ENV PATH="/root/.bun/bin:${PATH}"

COPY frontend /app/frontend
# We need some parts of drupal for the styles build
# Since the theme folder is not in Git, we create it here for the output.
RUN mkdir -p /app/drupal/docroot/themes/custom/blokkli_starterkit/css
# Copy the module files from the drupal-builder stage.
COPY --from=drupal-builder /app/drupal/docroot/modules/custom/blokkli_starterkit /app/drupal/docroot/modules/custom/blokkli_starterkit
WORKDIR /app/frontend
RUN bun install
# This will also run the 'styles' script which writes to /app/drupal/docroot/...
RUN bun run build

# Stage 3: CLI image
FROM uselagoon/php-8.3-cli-drupal:latest AS cli
RUN install-php-extensions memcached
COPY --from=drupal-builder /app/drupal /app/drupal
RUN mkdir -p /app/drupal/files-private && fix-permissions /app/drupal/files-private
# Copy styles generated by frontend build back to drupal
COPY --from=frontend-builder /app/drupal/docroot/themes/custom/blokkli_starterkit/css /app/drupal/docroot/themes/custom/blokkli_starterkit/css
COPY --from=frontend-builder /app/drupal/docroot/modules/custom/blokkli_starterkit/css /app/drupal/docroot/modules/custom/blokkli_starterkit/css
# Copy everything else from root that might be needed
COPY scripts /app/scripts
COPY .lagoon.yml /app/
ENV WEBROOT=drupal/docroot
ENV PATH="/app/drupal/vendor/bin:${PATH}"

# Stage 4: PHP image
FROM uselagoon/php-8.3-fpm:latest AS php
RUN install-php-extensions memcached
COPY --from=cli /app /app
ENV WEBROOT=drupal/docroot
ENV PATH="/app/drupal/vendor/bin:${PATH}"

# Stage 5: Nginx image
FROM uselagoon/nginx-drupal:latest AS nginx
COPY --from=cli /app /app
ENV WEBROOT=drupal/docroot
# Replace the stock Drupal server block with our reverse-proxy config
# (the base image puts its server block at conf.d/app.conf)
COPY .lagoon/nginx-lagoon.conf /etc/nginx/conf.d/app.conf

# Stage 6: Frontend image (Nuxt SSR)
FROM uselagoon/node-24:latest AS frontend
COPY --from=frontend-builder /app/frontend /app/frontend
WORKDIR /app/frontend
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV NITRO_HOST=0.0.0.0
# Nuxt 4/3 output is in .output
CMD ["node", ".output/server/index.mjs"]

# Stage 7: Elasticsearch image
# uselagoon only ships elasticsearch-7, but our composer elasticsearch/elasticsearch
# client is v9 (required by search_api_elasticsearch_client) and can't talk to a 7.x
# server. Bake the Lagoon-style single-node config into the official 9.x image.
FROM docker.elastic.co/elasticsearch/elasticsearch:9.3.8 AS elasticsearch
RUN { \
      echo 'discovery.type: single-node'; \
      echo 'xpack.security.enabled: false'; \
      echo 'ingest.geoip.downloader.enabled: false'; \
      # The persistent volume still holds ES7 data which a 9.x node refuses to
      # start on — use a fresh subdirectory on the same volume.
      echo 'path.data: /usr/share/elasticsearch/data/es9'; \
    } >> config/elasticsearch.yml
ENV ES_JAVA_OPTS="-Xms512m -Xmx512m"
