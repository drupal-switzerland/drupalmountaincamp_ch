{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "npm run styles && nuxt build",
    "dev": "nuxi dev",
    "debug": "nuxi dev --inspect=0.0.0.0",
    "typecheck": "nuxi typecheck",
    "generate": "nuxi generate",
    "preview": "nuxi preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "postinstall": "nuxt prepare",
    "styles": "npm run styles:ckeditor && npm run styles:backend",
    "styles:ckeditor": "postcss --config ./drupal ./app/assets/css/ckeditor.css -o ./../drupal/docroot/themes/custom/blokkli_starterkit/css/ckeditor.css",
    "styles:backend": "postcss --config ./drupal ./app/assets/css/backend.css -o ./../drupal/docroot/modules/custom/blokkli_starterkit/css/backend.css",
    "styles:backend:watch": "postcss --config ./drupal ./app/assets/css/backend.css -o ./../drupal/docroot/modules/custom/blokkli_starterkit/css/backend.css --watch",
    "test": "TZ=utc vitest",
    "test:ci": "TZ=utc vitest run"
  },
  "dependencies": {
    "@blokkli/editor": "^2.0.0-alpha.73",
    "@elastic/elasticsearch": "^9.5.1",
    "@formkit/addons": "^2.1.2",
    "@formkit/icons": "^2.1.2",
    "@formkit/inputs": "^2.1.2",
    "@formkit/nuxt": "^2.1.2",
    "@iframe-resizer/child": "^5.5.9",
    "@iframe-resizer/vue": "^5.5.9",
    "@lunarisapp/readability": "^1.1.1",
    "@rokka-io/nuxt": "^1.0.2",
    "@vueuse/core": "^14.4.0",
    "nuxt-easy-texts": "^2.2.0",
    "nuxt-graphql-middleware": "^5.4.0",
    "nuxt-language-negotiation": "^2.0.2",
    "nuxt-multi-cache": "^4.0.3",
    "nuxt-page-dependencies": "^1.2.0",
    "nuxt-plugin-order": "^1.0.0",
    "nuxt-svg-icon-sprite": "^2.0.2",
    "patch-package": "^8.0.1",
    "swiper": "^14.2.0",
    "vue3-click-away": "^1.2.4",
    "vuepal": "^3.0.6"
  },
  "overrides": {
    "serialize-javascript": "^7.0.3"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.4.2",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.2",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@types/iframe-resizer": "^4.0.0",
    "eslint-plugin-depend": "^1.5.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-tailwindcss": "^3.18.3",
    "glob": "^13.0.6",
    "happy-dom": "^20.14.5",
    "nuxt": "^4.5.2",
    "postcss-cli": "^12.0.0",
    "postcss-hexrgba": "github:thormeier/postcss-hexrgba",
    "postcss-nesting": "^14.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sass": "^1.104.1",
    "vitest": "^5.0.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.3.11"
  }
}
